<!DOCTYPE html>
<html>
<head>
    <title>Language Translation Tool</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>
<body>
    <h1>🌐 Language Translation Tool</h1>
    <form method="POST">
        <textarea name="text" placeholder="Enter text here..." required></textarea><br>
        <label>Source Language:</label>
        <input type="text" name="source_lang" placeholder="e.g., en"><br>
        <label>Target Language:</label>
        <input type="text" name="target_lang" placeholder="e.g., fr"><br>
        <button type="submit">Translate</button>
    </form>

    {% if translation %}
        <h2>Translated Text:</h2>
        <p>{{ translation }}</p>
        <button onclick="copyText()">Copy</button>
    {% endif %}

    <script>
        function copyText() {
            navigator.clipboard.writeText("{{ translation }}");
            alert("Copied to clipboard!");
        }
    </script>
</body>
</html>
